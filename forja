#!/usr/bin/env python3
"""
forja — small catalog for "things I've built".

Tracks tools / scripts / services / docs you create, with what each is for
(`description`) and *when you'd reach for it* (`utility`). Single-file Python
stdlib. registry.json is the source of truth; entries/<slug>.md is a richer
per-item page; README.md is the human-readable index.

Commands:
  add      register a new item (interactive if fields missing)
  list     show the catalog (filter --kind / --tag)
  show     show one item in detail
  status   dated operational evidence kept outside the public catalog
  edit     open an item's entries/<slug>.md in $EDITOR
  rm       remove an item
  path     print the registered path of an item (handy for `cd $(forja path X)`)
  sync     rewrite README.md from registry.json
  scan     suggest items by looking at common dirs (no automatic adds)
"""
from __future__ import annotations

import argparse
import datetime
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

VERSION = "0.3.0"
ROOT = Path(__file__).resolve().parent
REGISTRY = ROOT / "registry.json"
ENTRIES = ROOT / "entries"
README = ROOT / "README.md"
KINDS = ("tool", "script", "service", "launcher", "doc", "dataset")
DEFAULT_KIND = "tool"


# ── data layer ────────────────────────────────────────────────────────────────
def load() -> dict:
    if not REGISTRY.exists():
        return {"items": []}
    return json.loads(REGISTRY.read_text())


def store(reg: dict) -> None:
    REGISTRY.write_text(json.dumps(reg, indent=2, ensure_ascii=False) + "\n")


def slug(name: str) -> str:
    s = re.sub(r"[^a-zA-Z0-9._-]+", "-", name.strip().lower()).strip("-")
    return s or "item"


def find(reg: dict, name: str) -> dict | None:
    for it in reg["items"]:
        if it["name"] == name or slug(it["name"]) == slug(name):
            return it
    return None


# ── entry markdown ────────────────────────────────────────────────────────────
def entry_path(name: str) -> Path:
    return ENTRIES / f"{slug(name)}.md"


def write_entry(it: dict) -> None:
    ENTRIES.mkdir(parents=True, exist_ok=True)
    p = entry_path(it["name"])
    # Preserve the "## Notes" section if it already exists, so editing the
    # registry doesn't blow away free-form notes the user added.
    notes = ""
    if p.exists():
        m = re.search(r"(^## Notes\n.*)\Z", p.read_text(), re.DOTALL | re.MULTILINE)
        if m:
            notes = m.group(1)
    tags = ", ".join(it.get("tags") or []) or "—"
    gh = it.get("github") or "—"
    ver = it.get("version") or "—"
    created = it.get("created_at") or "—"
    body = f"""# {it["name"]}

| field | value |
|---|---|
| kind | `{it["kind"]}` |
| path | `{it["path"]}` |
| github | {gh} |
| version | {ver} |
| created | {created} |
| tags | {tags} |

**What it is.** {it.get("description", "—")}

**When to reach for it.** {it.get("utility", "—")}
"""
    if not notes:
        notes = ("## Notes\n\n*(free-form — anything you want to remember; "
                 "`forja sync` won't overwrite this section.)*\n")
    p.write_text(body + "\n" + notes)


# ── add ───────────────────────────────────────────────────────────────────────
def prompt(label: str, default: str = "") -> str:
    if not sys.stdin.isatty():     # non-interactive (CI / scripts) → accept default silently
        return default
    suffix = f" [{default}]" if default else ""
    try:
        v = input(f"{label}{suffix}: ").strip()
    except EOFError:
        v = ""
    return v or default


def cmd_add(a) -> int:
    reg = load()
    name = a.name or prompt("name")
    if not name:
        print("name required", file=sys.stderr); return 2
    existing = find(reg, name)
    if existing and not a.force:
        print(f"'{name}' already registered — use --force to overwrite, or `forja edit {name}`",
              file=sys.stderr)
        return 1
    path = a.path or prompt("path", default=str(Path.cwd()))
    path = os.path.expanduser(path)
    # remote-style HOST:/abs/path → don't try to resolve locally
    if not re.match(r"^[a-zA-Z0-9._-]+:/", path):
        try:
            path = str(Path(path).resolve())
        except Exception:
            pass
    kind = a.kind or prompt(f"kind ({'|'.join(KINDS)})", default=DEFAULT_KIND)
    if kind not in KINDS:
        print(f"kind must be one of {KINDS}", file=sys.stderr); return 2
    desc = a.desc or prompt("description (what is it?)")
    utility = a.utility or prompt("utility (when do you reach for it?)")
    tags = a.tags
    if tags is None:
        raw = prompt("tags (comma-separated)", default="")
        tags = [t.strip() for t in raw.split(",") if t.strip()] if raw else []
    github = a.github or prompt("github URL (or blank)", default="")
    version = a.version or prompt("version (or blank)", default="")

    item = {
        "name": name, "kind": kind, "path": path,
        "description": desc, "utility": utility,
        "tags": tags,
        "github": github or None,
        "version": version or None,
        "created_at": a.created_at or datetime.date.today().isoformat(),
    }
    # Preserve `extra` from existing entry across overwrites unless --extra is given
    if a.extra:
        try:
            item["extra"] = json.loads(a.extra)
        except Exception as e:
            print(f"--extra is not valid JSON: {e}", file=sys.stderr); return 2
    elif existing and existing.get("extra"):
        item["extra"] = existing["extra"]
    reg["items"] = [i for i in reg["items"] if i["name"] != name] + [item]
    reg["items"].sort(key=lambda x: (x["kind"], x["name"].lower()))
    store(reg)
    write_entry(item)
    sync_readme(reg)
    print(f"registered: {item['name']} ({item['kind']}) → {entry_path(name)}")
    return 0


# ── list / show / rm / path ───────────────────────────────────────────────────
def cmd_list(a) -> int:
    reg = load()
    items = reg["items"]
    if a.kind: items = [i for i in items if i["kind"] == a.kind]
    if a.tag:  items = [i for i in items if a.tag in (i.get("tags") or [])]
    if not items:
        print("nothing registered yet — `forja add`"); return 0
    by_kind: dict[str, list] = {}
    for it in items: by_kind.setdefault(it["kind"], []).append(it)
    name_w = max(len(i["name"]) for i in items)
    for k in sorted(by_kind):
        print(f"\n[{k}]")
        for it in sorted(by_kind[k], key=lambda x: x["name"].lower()):
            tags = " ".join(f"#{t}" for t in (it.get("tags") or []))
            print(f"  {it['name'].ljust(name_w)}  {it.get('utility', '')[:80]}"
                  + (f"  {tags}" if tags else ""))
    return 0


def cmd_show(a) -> int:
    reg = load(); it = find(reg, a.name)
    if not it:
        print(f"not found: {a.name}", file=sys.stderr); return 1
    p = entry_path(it["name"])
    if p.exists():
        print(p.read_text())
    else:
        print(json.dumps(it, indent=2, ensure_ascii=False))
    return 0


def operations_path() -> Path:
    """Private observations must never become registry or export metadata."""
    override = os.environ.get("FORJA_OPERATIONS_FILE")
    return Path(override).expanduser() if override else Path.home() / ".local/state/forja/operations.json"


def observation_date(value: str) -> datetime.datetime:
    if not isinstance(value, str):
        raise ValueError("invalid observation date")
    parsed = datetime.datetime.fromisoformat(value.replace("Z", "+00:00"))
    if parsed.tzinfo is None:
        raise ValueError("observation dates require a timezone")
    return parsed


def load_operations(reg: dict, path: Path, now: datetime.datetime) -> list[dict]:
    if not path.exists():
        return []
    data = json.loads(path.read_text())
    if not isinstance(data, dict) or set(data) != {"schema_version", "observations"}:
        raise ValueError("invalid operations document")
    if type(data["schema_version"]) is not int or data["schema_version"] != 1 or not isinstance(data["observations"], list):
        raise ValueError("unsupported operations schema")
    known = {it["name"] for it in reg["items"]}
    required = {"item", "observed_at", "expires_at", "state", "summary", "evidence", "next_action"}
    optional = {"runtime", "source", "consumer"}
    seen, output = set(), []
    for row in data["observations"]:
        if not isinstance(row, dict) or not required <= set(row) or set(row) - required - optional:
            raise ValueError("invalid observation fields")
        if any(not isinstance(row[k], str) or not row[k].strip() for k in set(row) - {"evidence"}):
            raise ValueError("empty or invalid observation text")
        if row["item"] not in known or row["item"] in seen:
            raise ValueError("unknown or duplicate catalog item")
        seen.add(row["item"])
        if row["state"] not in {"verified", "partial", "blocked", "unverified"}:
            raise ValueError("unknown evidence state")
        if not isinstance(row["evidence"], list) or not row["evidence"] or any(not isinstance(v, str) or not v.strip() for v in row["evidence"]):
            raise ValueError("evidence references required")
        observed, expires = observation_date(row["observed_at"]), observation_date(row["expires_at"])
        if expires <= observed or observed > now + datetime.timedelta(minutes=5):
            raise ValueError("inconsistent observation dates")
        output.append(dict(row, needs_review=now >= expires))
    return output


def cmd_status(a) -> int:
    reg = load()
    item = find(reg, a.name) if a.name else None
    if a.name and not item:
        print(f"not found: {a.name}", file=sys.stderr)
        return 1
    now = datetime.datetime.now(datetime.timezone.utc)
    try:
        rows = load_operations(reg, operations_path(), now)
    except (OSError, ValueError, TypeError):
        print("No se pudo validar la evidencia operativa local; no se considera verificada.", file=sys.stderr)
        return 2
    if item:
        rows = [row for row in rows if row["item"] == item["name"]]
    if a.json:
        print(json.dumps({"schema_version": 1, "as_of": now.isoformat(), "observations": rows}, ensure_ascii=False, indent=2))
        return 0
    if not rows:
        print("Sin evidencia operativa registrada. Esto no acredita que el proyecto esté disponible o caído.")
    for row in rows:
        state = "requiere revisión" if row["needs_review"] else row["state"]
        print(f"\n{row['item']} — {state} (observado {row['observed_at']})")
        print(row["summary"])
        for key in ("runtime", "source", "consumer"):
            if key in row:
                print(f"  {key}: {row[key]}")
        print(f"  Siguiente: {row['next_action']}")
        print("  Evidencia: " + "; ".join(row["evidence"]))
        print(f"  Revisar antes de: {row['expires_at']}")
    return 0


def cmd_rm(a) -> int:
    reg = load(); it = find(reg, a.name)
    if not it:
        print(f"not found: {a.name}", file=sys.stderr); return 1
    if not a.yes:
        if prompt(f"remove '{it['name']}'? type yes to confirm").lower() != "yes":
            print("cancelled"); return 0
    reg["items"] = [i for i in reg["items"] if i["name"] != it["name"]]
    store(reg)
    p = entry_path(it["name"])
    if p.exists(): p.unlink()
    sync_readme(reg)
    print(f"removed: {it['name']}")
    return 0


def cmd_path(a) -> int:
    reg = load(); it = find(reg, a.name)
    if not it: return 1
    print(it["path"]); return 0


def cmd_edit(a) -> int:
    reg = load(); it = find(reg, a.name)
    if not it:
        print(f"not found: {a.name}", file=sys.stderr); return 1
    editor = os.environ.get("EDITOR", "vi")
    subprocess.run([editor, str(entry_path(it["name"]))])
    return 0


# ── sync README ───────────────────────────────────────────────────────────────
def sync_readme(reg: dict | None = None) -> None:
    if reg is None: reg = load()
    items = reg["items"]
    lines = [
        "# forja",
        "",
        "*Catálogo personal — todo lo que voy construyendo, con descripción y utilidad.*",
        "",
        f"_{len(items)} items registrados. Fuente de verdad: `registry.json`. "
        "Páginas por item en `entries/`._",
        "",
        "## CLI",
        "```",
        "forja add                  # registrar (interactivo si faltan campos)",
        "forja list [--kind X]      # ver el catálogo",
        "forja show NAME            # ficha completa",
        "forja status [NAME]        # evidencia operativa local con fecha; --json para agentes",
        "forja edit NAME            # editar la ficha (Notas libres se conservan)",
        "forja rm   NAME            # quitar",
        "forja path NAME            # ruta registrada (útil: cd $(forja path X))",
        "forja sync                 # regenerar este README desde registry.json",
        "forja scan                 # candidatos en ~/ aún sin registrar",
        "forja missing-gh           # cola de publicación (items sin github)",
        "```",
        "",
    ]
    by_kind: dict[str, list] = {}
    for it in items: by_kind.setdefault(it["kind"], []).append(it)
    for k in sorted(by_kind):
        lines += [f"## {k}", "",
                  "| nombre | utilidad | ruta | github |",
                  "|---|---|---|---|"]
        for it in sorted(by_kind[k], key=lambda x: x["name"].lower()):
            gh = it.get("github") or "—"
            if gh and gh != "—": gh = f"[link]({gh})"
            util = (it.get("utility") or "").replace("|", "\\|")
            lines.append(f"| **[{it['name']}](entries/{slug(it['name'])}.md)** | "
                         f"{util} | `{it['path']}` | {gh} |")
        lines.append("")
    README.write_text("\n".join(lines))


def cmd_sync(a) -> int:
    sync_readme()
    print(f"wrote {README}")
    return 0


# ── scan suggestions ──────────────────────────────────────────────────────────
def cmd_missing_gh(a) -> int:
    """List registered items without a github URL — your 'publish queue'."""
    reg = load()
    missing = [i for i in reg["items"] if not (i.get("github") or "").strip()]
    if not missing:
        print("todo tiene github URL — nada que publicar."); return 0
    by_kind: dict[str, list] = {}
    for it in missing: by_kind.setdefault(it["kind"], []).append(it)
    print(f"{len(missing)} items sin github:\n")
    name_w = max(len(i["name"]) for i in missing)
    for k in sorted(by_kind):
        print(f"[{k}]")
        for it in sorted(by_kind[k], key=lambda x: x["name"].lower()):
            tags = " ".join(f"#{t}" for t in (it.get("tags") or []))
            print(f"  {it['name'].ljust(name_w)}  {it['path']}"
                  + (f"  {tags}" if tags else ""))
        print()
    print("Para publicar uno desde su directorio:")
    print("  cd $(forja path NAME) && gh repo create Obrais-cloud/NAME --public --source=. --push")
    print("Luego añade el URL al catálogo:")
    print("  forja add --force --name NAME --path $(forja path NAME) --github https://github.com/...")
    return 0


def cmd_scan(a) -> int:
    """Look at ~/ for dirs that look like projects we haven't registered yet."""
    reg = load()
    known = {Path(i["path"]).name.lower() for i in reg["items"]}
    home = Path.home()
    candidates = []
    for p in sorted(home.iterdir()):
        if not p.is_dir() or p.name.startswith("."): continue
        if p.name.lower() in known: continue
        has_git = (p / ".git").exists()
        has_readme = (p / "README.md").exists() or (p / "readme.md").exists()
        if has_git or has_readme:
            candidates.append((p, has_git, has_readme))
    if not candidates:
        print("nothing obvious in ~/ that isn't already registered."); return 0
    print("candidatos sin registrar (git=g, readme=r):")
    for p, g, r in candidates:
        flags = ("g" if g else "-") + ("r" if r else "-")
        print(f"  [{flags}] {p.name}")
    print("\nregistrarlo: `cd ~/<name> && forja add --path .`")
    return 0


# ── MEMORY.md sync (bounded auto-generated block) ─────────────────────────────
MEMORY_PATH = Path.home() / ".claude/projects/-Users-braisrevalderia/memory/MEMORY.md"
MEM_START = "<!-- forja:catalog START — auto-generated by `forja sync-memory`; do not edit -->"
MEM_END   = "<!-- forja:catalog END -->"


def _memory_block(reg: dict) -> str:
    items = reg["items"]
    n = len(items)
    by_kind: dict[str, int] = {}
    for it in items: by_kind[it["kind"]] = by_kind.get(it["kind"], 0) + 1
    by_kind_s = " · ".join(f"{v} {k}" for k, v in sorted(by_kind.items(), key=lambda x: -x[1]))
    with_gh = sum(1 for i in items if (i.get("github") or "").strip())
    fdv = sorted(i["name"] for i in items if "fillos-do-vento" in (i.get("tags") or []))
    recent = sorted(items, key=lambda i: i.get("created_at") or "", reverse=True)[:5]
    recent_s = ", ".join(f"`{i['name']}`" for i in recent)
    lines = [
        MEM_START,
        "## Catálogo `forja` (auto)",
        "",
        f"**~/forja** — catálogo personal de todo lo construido. "
        f"Repo: https://github.com/Obrais-cloud/forja",
        "",
        f"- **{n} items** ({by_kind_s})",
        f"- **{with_gh} con enlace GitHub** · {n - with_gh} sin enlace (`forja missing-gh`)",
        f"- **fillos-do-vento ({len(fdv)})**: {', '.join(fdv) if fdv else '—'}",
        f"- **últimos añadidos**: {recent_s}",
        "",
        "Comandos: `forja list` · `forja show NAME` · `forja status NAME` (evidencia local fechada) · `forja missing-gh` · `cd $(forja path NAME)`",
        MEM_END,
    ]
    return "\n".join(lines)


def cmd_sync_memory(a) -> int:
    if not MEMORY_PATH.exists():
        print(f"MEMORY.md no encontrado en {MEMORY_PATH}", file=sys.stderr); return 1
    text = MEMORY_PATH.read_text()
    block = _memory_block(load())
    if MEM_START in text and MEM_END in text:
        # replace existing block
        new = re.sub(
            re.escape(MEM_START) + r".*?" + re.escape(MEM_END),
            block, text, count=1, flags=re.DOTALL,
        )
        action = "updated"
    else:
        # append at the end with a leading blank line
        new = text.rstrip() + "\n\n" + block + "\n"
        action = "appended"
    MEMORY_PATH.write_text(new)
    print(f"MEMORY.md {action} ({len(load()['items'])} items in catalog block)")
    return 0


# ── ollaverse import / export (TOOLS array in index.html) ─────────────────────
OLLAVERSE_DEFAULT = Path.home() / "ollaverse" / "index.html"
TOOLS_RE = re.compile(r"(const TOOLS\s*=\s*\[)(.*?)(\];)", re.DOTALL)


def _parse_features(chunk: str) -> list[str]:
    """Extract string array contents tolerating \\\" and \\\\ escapes."""
    out, cur, in_str, esc = [], [], False, False
    for ch in chunk:
        if esc:
            cur.append(ch); esc = False
        elif in_str and ch == "\\":
            esc = True
        elif ch == '"' and not in_str:
            in_str = True; cur = []
        elif ch == '"' and in_str:
            in_str = False
            out.append("".join(cur))
        elif in_str:
            cur.append(ch)
    return out


def _parse_entry(line: str) -> dict | None:
    e: dict = {}
    for k in ("name", "description", "language", "category", "icon"):
        m = re.search(rf'{k}:\s*"((?:[^"\\]|\\.)*)"', line)
        if m: e[k] = m.group(1).replace('\\"', '"').replace("\\\\", "\\")
    m = re.search(r'color:\s*"((?:[^"\\]|\\.)*)"', line)
    if m: e["color"] = m.group(1)
    else:
        m = re.search(r"color:\s*(var\([^)]+\))", line)
        if m: e["color"] = m.group(1)
    m = re.search(r"features:\s*\[(.*?)\](?=\s*[,}])", line)
    if m: e["features"] = _parse_features(m.group(1))
    return e if "name" in e else None


def _format_entry(e: dict) -> str:
    parts = []
    def q(s: str) -> str: return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'
    if "name" in e: parts.append(f"name: {q(e['name'])}")
    if "description" in e: parts.append(f"description: {q(e['description'])}")
    if "features" in e and e["features"]:
        feats = ", ".join(q(f) for f in e["features"])
        parts.append(f"features: [{feats}]")
    if "language" in e: parts.append(f"language: {q(e['language'])}")
    if "category" in e: parts.append(f"category: {q(e['category'])}")
    if "icon" in e: parts.append(f"icon: {q(e['icon'])}")
    if "color" in e:
        c = e["color"]
        parts.append(f"color: {c}" if c.startswith("var(") else f"color: {q(c)}")
    return "{ " + ", ".join(parts) + " }"


def cmd_import_ollaverse(a) -> int:
    path = Path(a.path).expanduser() if a.path else OLLAVERSE_DEFAULT
    if not path.exists():
        print(f"ollaverse not found at {path}", file=sys.stderr); return 1
    html = path.read_text()
    m = TOOLS_RE.search(html)
    if not m:
        print("could not find `const TOOLS = [...]` in the file", file=sys.stderr); return 1
    body = m.group(2)
    entries = []
    for line in body.splitlines():
        line = line.strip().rstrip(",")
        if not line.startswith("{"): continue
        e = _parse_entry(line)
        if e: entries.append(e)
    if not entries:
        print("no TOOLS entries parsed", file=sys.stderr); return 1
    reg = load()
    attached, registered = 0, 0
    for e in entries:
        it = find(reg, e["name"])
        if it:
            it.setdefault("extra", {})["ollaverse"] = e
            write_entry(it); attached += 1
        else:
            new_it = {
                "name": e["name"], "kind": "tool",
                "path": str(Path.home() / e["name"]),
                "description": e.get("description", ""),
                "utility": "(auto-import desde ollaverse — actualízalo con forja edit)",
                "tags": ["ollama"], "github": None, "version": None,
                "created_at": datetime.date.today().isoformat(),
                "extra": {"ollaverse": e},
            }
            reg["items"].append(new_it)
            write_entry(new_it); registered += 1
    reg["items"].sort(key=lambda x: (x["kind"], x["name"].lower()))
    store(reg); sync_readme(reg)
    print(f"ollaverse → forja: {attached} extras attached, {registered} new items registered")
    return 0


def cmd_export_ollaverse(a) -> int:
    path = Path(a.path).expanduser() if a.path else OLLAVERSE_DEFAULT
    if not path.exists():
        print(f"ollaverse not found at {path}", file=sys.stderr); return 1
    reg = load()
    items = [i for i in reg["items"] if i.get("extra", {}).get("ollaverse")]
    if not items:
        print("no items have extra.ollaverse — run `forja import-ollaverse` first.",
              file=sys.stderr); return 1
    # honour the original TOOLS order where present, append any new ones at the end
    html = path.read_text()
    m = TOOLS_RE.search(html)
    if not m:
        print("could not find `const TOOLS = [...]` in the file", file=sys.stderr); return 1
    existing_order = []
    for line in m.group(2).splitlines():
        line = line.strip().rstrip(",")
        if not line.startswith("{"): continue
        e = _parse_entry(line)
        if e and "name" in e: existing_order.append(e["name"])
    by_name = {i["name"]: i for i in items}
    ordered = [by_name[n] for n in existing_order if n in by_name]
    extras = [i for i in items if i["name"] not in set(existing_order)]
    ordered += sorted(extras, key=lambda i: i["name"].lower())
    lines = ["  " + _format_entry(i["extra"]["ollaverse"]) + "," for i in ordered]
    new_body = "\n" + "\n".join(lines) + "\n"
    new_html = html[:m.start(2)] + new_body + html[m.end(2):]
    path.write_text(new_html)
    print(f"forja → ollaverse: wrote {len(ordered)} TOOLS entries → {path}")
    return 0


# ── auto-watcher (launchd WatchPaths) ─────────────────────────────────────────
WATCH_LABEL = "com.braisrevalderia.forja-watch"
WATCH_PLIST = Path.home() / "Library" / "LaunchAgents" / f"{WATCH_LABEL}.plist"
WATCH_SCRIPT = ROOT / "bin" / "forja-on-change.sh"
WATCH_LOG = ROOT / "logs" / "watch.log"


def _watcher_script_body() -> str:
    return f"""#!/bin/bash
# auto-generated by `forja install-watcher` — do not edit by hand
TS=$(date '+%Y-%m-%d %H:%M:%S')
LOG="{WATCH_LOG}"
mkdir -p "$(dirname "$LOG")"
{{
  echo "[$TS] registry.json changed → syncing"
  {ROOT / 'forja'} sync-memory
  if [ -f "$HOME/ollaverse/index.html" ]; then
    {ROOT / 'forja'} export-ollaverse
  fi
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] done"
  echo
}} >> "$LOG" 2>&1
"""


def _watcher_plist_body() -> str:
    return f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>{WATCH_LABEL}</string>
  <key>ProgramArguments</key>
  <array>
    <string>{WATCH_SCRIPT}</string>
  </array>
  <key>WatchPaths</key>
  <array>
    <string>{REGISTRY}</string>
  </array>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>{WATCH_LOG}</string>
  <key>StandardErrorPath</key><string>{WATCH_LOG}</string>
</dict>
</plist>
"""


def _launchctl(*args) -> tuple[int, str]:
    r = subprocess.run(["launchctl", *args], capture_output=True, text=True)
    return r.returncode, (r.stdout + r.stderr).strip()


def cmd_install_watcher(a) -> int:
    uid = os.getuid()
    target = f"gui/{uid}/{WATCH_LABEL}"
    # write helper script
    WATCH_SCRIPT.parent.mkdir(parents=True, exist_ok=True)
    WATCH_SCRIPT.write_text(_watcher_script_body())
    WATCH_SCRIPT.chmod(0o755)
    # write plist
    WATCH_PLIST.parent.mkdir(parents=True, exist_ok=True)
    WATCH_PLIST.write_text(_watcher_plist_body())
    WATCH_LOG.parent.mkdir(parents=True, exist_ok=True)
    # unload existing (ignore failure if not loaded), then bootstrap fresh
    _launchctl("bootout", target)
    rc, out = _launchctl("bootstrap", f"gui/{uid}", str(WATCH_PLIST))
    if rc != 0:
        print(f"launchctl bootstrap failed: {out}", file=sys.stderr); return 1
    print(f"watcher installed: {WATCH_LABEL}")
    print(f"  plist : {WATCH_PLIST}")
    print(f"  script: {WATCH_SCRIPT}")
    print(f"  watching: {REGISTRY}")
    print(f"  log    : {WATCH_LOG}")
    print(f"  on change: forja sync-memory + forja export-ollaverse (if ~/ollaverse exists)")
    return 0


def cmd_uninstall_watcher(a) -> int:
    uid = os.getuid()
    target = f"gui/{uid}/{WATCH_LABEL}"
    rc, out = _launchctl("bootout", target)
    if WATCH_PLIST.exists(): WATCH_PLIST.unlink()
    if WATCH_SCRIPT.exists(): WATCH_SCRIPT.unlink()
    if rc != 0 and "Could not find" not in out and "No such" not in out:
        print(f"launchctl bootout: {out}", file=sys.stderr)
    print(f"watcher uninstalled: {WATCH_LABEL} (logs kept at {WATCH_LOG})")
    return 0


# ── main ──────────────────────────────────────────────────────────────────────
def build_parser():
    p = argparse.ArgumentParser(prog="forja", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    a = sub.add_parser("add", help="register a new item (interactive if fields missing)")
    a.add_argument("--name"); a.add_argument("--path")
    a.add_argument("--kind", choices=KINDS)
    a.add_argument("--desc"); a.add_argument("--utility")
    a.add_argument("--tags", type=lambda s: [t.strip() for t in s.split(",") if t.strip()])
    a.add_argument("--github"); a.add_argument("--version")
    a.add_argument("--created-at", dest="created_at")
    a.add_argument("--extra", help="JSON dict with per-target metadata (e.g. extra.ollaverse)")
    a.add_argument("--force", action="store_true")
    a.set_defaults(func=cmd_add)

    l = sub.add_parser("list", help="show the catalog")
    l.add_argument("--kind", choices=KINDS); l.add_argument("--tag")
    l.set_defaults(func=cmd_list)

    s = sub.add_parser("show", help="show one item"); s.add_argument("name")
    s.set_defaults(func=cmd_show)
    st = sub.add_parser("status", help="read dated private operational evidence; no network or catalog changes")
    st.add_argument("name", nargs="?")
    st.add_argument("--json", action="store_true")
    st.set_defaults(func=cmd_status)
    e = sub.add_parser("edit", help="open an item's entry in $EDITOR"); e.add_argument("name")
    e.set_defaults(func=cmd_edit)
    r = sub.add_parser("rm", help="remove an item"); r.add_argument("name")
    r.add_argument("--yes", action="store_true"); r.set_defaults(func=cmd_rm)
    pa = sub.add_parser("path", help="print registered path"); pa.add_argument("name")
    pa.set_defaults(func=cmd_path)
    sy = sub.add_parser("sync", help="regenerate README.md from registry.json")
    sy.set_defaults(func=cmd_sync)
    sc = sub.add_parser("scan", help="suggest unregistered project dirs in ~/")
    sc.set_defaults(func=cmd_scan)
    mg = sub.add_parser("missing-gh", help="list registered items that have no github URL (publish queue)")
    mg.set_defaults(func=cmd_missing_gh)
    sm = sub.add_parser("sync-memory",
                        help="write an auto-generated catalog block into MEMORY.md (Claude's session memory)")
    sm.set_defaults(func=cmd_sync_memory)
    io = sub.add_parser("import-ollaverse",
                        help="capture TOOLS metadata (features/lang/category/icon/color) from ~/ollaverse into forja.extra.ollaverse")
    io.add_argument("--path", default=None, help="override path to ollaverse index.html")
    io.set_defaults(func=cmd_import_ollaverse)
    eo = sub.add_parser("export-ollaverse",
                        help="regenerate the TOOLS array in ~/ollaverse/index.html from forja.extra.ollaverse")
    eo.add_argument("--path", default=None)
    eo.set_defaults(func=cmd_export_ollaverse)
    iw = sub.add_parser("install-watcher",
                        help="install a launchd LaunchAgent that auto-runs sync-memory + export-ollaverse when registry.json changes")
    iw.set_defaults(func=cmd_install_watcher)
    uw = sub.add_parser("uninstall-watcher",
                        help="remove the launchd LaunchAgent installed by install-watcher")
    uw.set_defaults(func=cmd_uninstall_watcher)
    return p


def main(argv=None):
    args = build_parser().parse_args(argv)
    return args.func(args) or 0


if __name__ == "__main__":
    sys.exit(main())
